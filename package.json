{
	"name": "pickle",
	"version": "0.1.1",
	"description": "Local-first, file-based agent inbox for Obsidian.",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"build:test": "npm run build && node copy-files.mjs",
		"copy-files": "node copy-files.mjs",
		"dev": "node esbuild.config.mjs",
		"lint": "node scripts/run-lint.mjs",
		"lint:css": "stylelint \"styles.css\" --max-warnings=0",
		"lint:ts": "eslint . --max-warnings=0",
		"test": "vitest run",
		"test:mdbase-spec": "vitest run test/mdbaseSpecCompatibility.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"obsidian",
		"pickle",
		"inbox",
		"agent",
		"schema",
		"approval"
	],
	"author": "Callum Alpass",
	"license": "MIT",
	"dependencies": {
		"ulid": "^2.3.0",
		"yaml": "^2.8.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@types/node": "^24.10.1",
		"@typescript-eslint/eslint-plugin": "^8.48.0",
		"@typescript-eslint/parser": "^8.48.0",
		"esbuild": "^0.27.0",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "^16.5.0",
		"obsidian": "latest",
		"obsidian-typings": "^6.24.0",
		"stylelint": "^16.26.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.13"
	}
}
